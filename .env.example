# Copy to .env and fill in. Never commit .env.
# Local values are filled in below. For production (Neon + Render/Railway + Vercel) set the same
# variables in each platform's dashboard instead; see docs/deploy.md. Never paste real keys here.

# --- API ---
# development | test | production. The Docker image sets production.
NODE_ENV=development
# Local port. Render and Railway set PORT, which wins over API_PORT.
API_PORT=3000
# PORT=
LOG_LEVEL=info

# --- Database ---
# Used by the app. Neon: the POOLED connection string (host contains "-pooler"), e.g.
# postgresql://<user>:<password>@<endpoint>-pooler.eu-central-1.aws.neon.tech/<db>?sslmode=require
# sslmode=require turns on TLS with a verified certificate.
DATABASE_URL=postgres://voita:voita@localhost:5432/voita_kone
# Used by migrations (db:migrate, db:migrate:prod, setup:prod). Neon: the DIRECT connection
# string (no "-pooler"). Falls back to DATABASE_URL when empty.
DATABASE_DIRECT_URL=
# Connections in the app's pool (default 5). Keep it small on Neon.
DATABASE_POOL_SIZE=5
# Used only by tests. Created automatically by the api test setup. Not needed in production.
TEST_DATABASE_URL=postgres://voita:voita@localhost:5432/voita_kone_test

# --- HTTP ---
# Comma-separated list of origins allowed to call the API (no trailing slash needed).
# Production: your Vercel URL(s), e.g. https://voita-kaleva.vercel.app. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Proxies in front of the API, so rate limits see the real client IP. Default: 1 in production
# (Render / Railway), 0 locally.
# TRUST_PROXY_HOPS=1

# --- Highlight uploads ---
# Folder for uploaded highlight videos. Locally it defaults to ./uploads. In production, not set
# or not writable → the highlight form takes video links only (and says why). Only set it to a
# persistent disk / volume (e.g. /data/uploads), or files are lost on every deploy.
UPLOAD_DIR=

# --- Email (later; Mailpit in dev, see infra/docker-compose.yml). Not needed in production yet ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Voita kone <no-reply@voitakone.local>
# Comma-separated list of editor/admin emails. The first one becomes the demo editor in the seed.
ADMIN_EMAILS=editor@voitakone.local

# --- Liiga API (see docs/liiga_api/endpoints.md) ---
# Public base URL. Endpoints are under /api/v1.
LIIGA_API_BASE_URL=https://prod.liiga-backend.liiga.fi/stats
# Sent as the x-api-key header. Never commit or log it.
LIIGA_API_KEY=

# --- Games API (step 2) ---
# Liiga team id whose games are flagged `featured` and listed first (default Kärpät).
FEATURED_TEAM_EXTERNAL_ID=495643563:kärpät
# Poll Liiga for games that should be live, every N seconds (only when such games exist).
LIVE_SYNC_ENABLED=true
LIVE_SYNC_INTERVAL_SECONDS=30
# /api/v1/demo/* replays a real finished game for judging. Default: on except in production.
DEMO_REPLAY_ENABLED=true

# --- LLM (empty = template texts) ---
LLM_API_KEY=
LLM_MODEL=
# AI previews and summaries: at most this many LLM calls a minute
LLM_MAX_CALLS_PER_MINUTE=10
# Room questions: mock (JSON bank) | llm (not built yet, falls back to mock)
ROOM_QUESTIONS_SOURCE=mock

# --- Web app (read by Vite at BUILD time, exposed to the browser: never put secrets here) ---
# Production builds fail without it, and it must be https (e.g. https://<your-api>/api/v1).
VITE_API_BASE_URL=http://localhost:3000/api/v1
# "true" = always show the demo replay ("Jump in time"). Otherwise add ?demo=1 to the URL.
VITE_DEMO_MODE=false
