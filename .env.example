# Copy to .env and fill in. Never commit .env.

# --- API ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://voita:voita@localhost:5432/voita_kone
# Used only by tests. Created automatically by the api test setup.
TEST_DATABASE_URL=postgres://voita:voita@localhost:5432/voita_kone_test
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Mailpit in dev, see infra/docker-compose.yml) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Voita kone <no-reply@voitakone.local>
# Comma-separated list of editor/admin emails. The first one becomes the demo editor in the seed.
ADMIN_EMAILS=editor@voitakone.local

# --- Liiga API (see docs/liiga_api/endpoints.md) ---
# Public base URL. Endpoints are under /api/v1.
LIIGA_API_BASE_URL=https://prod.liiga-backend.liiga.fi/stats
# Sent as the x-api-key header. Never commit or log it.
LIIGA_API_KEY=

# --- Games API (step 2) ---
# Liiga team id whose games are flagged `featured` and listed first (default Kärpät).
FEATURED_TEAM_EXTERNAL_ID=495643563:kärpät
# Poll Liiga for games that should be live, every N seconds (only when such games exist).
LIVE_SYNC_ENABLED=true
LIVE_SYNC_INTERVAL_SECONDS=30
# /api/v1/demo/* replays a real finished game for judging. Default: on except in production.
DEMO_REPLAY_ENABLED=true

# --- LLM (empty until step 5) ---
LLM_API_KEY=
LLM_MODEL=
# AI previews and summaries: at most this many LLM calls a minute
LLM_MAX_CALLS_PER_MINUTE=10
# Room questions: mock (JSON bank) | llm (not built yet, falls back to mock)
ROOM_QUESTIONS_SOURCE=mock

# --- Web app (read by Vite, exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
# "true" = always show the demo replay ("Jump in time"). Otherwise add ?demo=1 to the URL.
VITE_DEMO_MODE=false
