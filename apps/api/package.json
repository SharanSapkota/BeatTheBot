{
  "name": "@voita_kone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent=passed-only",
    "db:migrate": "tsx src/db/scripts/migrate.ts latest",
    "db:migrate:prod": "node dist/scripts/migrate.js latest",
    "db:migrate:down": "tsx src/db/scripts/migrate.ts down",
    "db:codegen": "kysely-codegen --dialect postgres --env-file ../../.env --exclude-pattern \"kysely_migration*\" --out-file src/db/database_types.ts && prettier --write src/db/database_types.ts",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:reset": "tsx src/db/scripts/reset.ts",
    "setup:prod": "node dist/scripts/setup_prod.js",
    "sync:liiga": "tsx src/jobs/scripts/sync_games.ts",
    "backtest": "tsx src/jobs/scripts/backtest.ts",
    "model:run": "tsx src/jobs/scripts/run_model.ts",
    "stories:generate": "tsx src/jobs/scripts/generate_stories.ts",
    "make:editor": "tsx src/jobs/scripts/make_editor.ts",
    "make:editor:prod": "node dist/scripts/make_editor.js",
    "make:admin": "tsx src/jobs/scripts/make_admin.ts",
    "make:admin:prod": "node dist/scripts/make_admin.js",
    "elections:seed_demo": "tsx src/db/scripts/seed_demo_election.ts",
    "sports:seed_demo": "tsx src/db/scripts/seed_demo_sports.ts",
    "rooms:seed_demo": "tsx src/db/scripts/seed_demo_room.ts",
    "rooms:advance_slot": "tsx src/db/scripts/advance_room_slot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@voita_kone/fact_checker": "workspace:*",
    "@voita_kone/prediction_model": "workspace:*",
    "@voita_kone/scoring": "workspace:*",
    "@voita_kone/shared_types": "workspace:*",
    "cors": "catalog:",
    "date-fns": "catalog:",
    "date-fns-tz": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@voita_kone/config": "workspace:*",
    "eslint": "catalog:",
    "kysely-codegen": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
